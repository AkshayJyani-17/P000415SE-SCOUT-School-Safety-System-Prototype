PORT=5000
BACKEND_URL=http://localhost:5000
JWT_SECRET=replace_with_local_secret

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Optional for hosted deployments. Use this instead of FIREBASE_SERVICE_ACCOUNT_PATH when the JSON file is not available.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Email is sent through the Brevo HTTPS API (SMTP is blocked on Render's free tier).
# The sender address must be verified under Senders & IP in Brevo.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=SCOUT Safety System

CLICKSEND_USERNAME=your_clicksend_username
CLICKSEND_API_KEY=your_clicksend_api_key
# Country used to interpret local numbers such as 0412 345 678.
SMS_DEFAULT_COUNTRY=AU

# Shared secret Brevo and ClickSend must send as ?secret=... on delivery receipt webhooks.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_WEBHOOK_SECRET=replace_with_a_long_random_string

# Demo seeding is opt-in and never runs when NODE_ENV=production.
# Leave false unless this points at a local database you are happy to overwrite.
SEED_DEMO_DATA=false

# Company Admin bootstrap (used by: npm run seed:company-admin)
# No other seed script creates a Company Admin account.
COMPANY_ADMIN_EMAIL=admin@example.com
COMPANY_ADMIN_PASSWORD=choose_a_local_password
COMPANY_ADMIN_NAME=Company Admin
